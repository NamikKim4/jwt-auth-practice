# 이 파일을 복사해서 .env로 만들고, 값들을 본인만 아는 값으로 바꿔서 쓰세요.
#   cp .env.example .env   (윈도우 파워쉘: copy .env.example .env)
#
# .env 파일은 .gitignore에 들어있어서 git에는 올라가지 않아요 (진짜 비밀번호가 커밋되면 안 되니까).

# PostgreSQL 계정 정보
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=authdb

# JWT 토큰 서명에 쓰는 비밀 키. 아무 값이나 길고 예측 불가능한 문자열로 바꾸세요.
# 터미널에서 이렇게 만들 수 있어요: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string

# 리프레시 토큰(자동 로그인 연장용)이 살아있는 기간 (일 단위). 이 기간 안에는 재로그인 없이
# 액세스 토큰을 계속 새로 받아올 수 있고, 지나면 다시 로그인해야 해요.
REFRESH_TOKEN_EXPIRE_DAYS=14

# 회원가입 화면에서 "관리자로 가입"을 선택할 때 입력해야 하는 코드.
ADMIN_SIGNUP_CODE=change-this-admin-code

# 날씨 정보를 가져올 위치 (완전 무료 API인 Open-Meteo 사용, 회원가입/카드 등록 필요 없음)
WEATHER_CITY_NAME=서울
WEATHER_LAT=37.5665
WEATHER_LON=126.9780
# 30분마다 자동으로 새 날씨를 가져와요 (초 단위: 1800 = 30분)
WEATHER_FETCH_INTERVAL_SECONDS=1800

# 게시글을 PostgreSQL에서 MongoDB로 자동 백업하는 주기 (초 단위: 3600 = 1시간)
BACKUP_SYNC_INTERVAL_SECONDS=3600

# 날씨 기록을 PostgreSQL에서 MongoDB로 자동 백업하는 주기 (초 단위: 600 = 10분)
WEATHER_BACKUP_INTERVAL_SECONDS=600

# PostgreSQL 테이블을 브라우저에서 보게 해주는 pgAdmin 관리자 화면 로그인 정보.
# http://localhost:5050 접속 시 이 이메일/비밀번호로 로그인해요.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-this-password

# MongoDB 컬렉션을 브라우저에서 보게 해주는 mongo-express 관리자 화면 로그인 정보.
# http://localhost:8081 접속 시 브라우저 기본 로그인창에 이 아이디/비밀번호를 입력해요.
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-this-password
