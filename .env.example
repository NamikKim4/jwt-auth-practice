# 이 파일을 복사해서 .env로 만들고, 값들을 본인만 아는 값으로 바꿔서 쓰세요.
#   cp .env.example .env   (윈도우 파워쉘: copy .env.example .env)
#
# .env 파일은 .gitignore에 들어있어서 git에는 올라가지 않아요 (진짜 비밀번호가 커밋되면 안 되니까).

# PostgreSQL 계정 정보
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=authdb

# JWT 토큰 서명에 쓰는 비밀 키. 아무 값이나 길고 예측 불가능한 문자열로 바꾸세요.
# 터미널에서 이렇게 만들 수 있어요: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string

# 회원가입 화면에서 "관리자로 가입"을 선택할 때 입력해야 하는 코드.
ADMIN_SIGNUP_CODE=change-this-admin-code

# 날씨 정보를 가져올 위치 (완전 무료 API인 Open-Meteo 사용, 회원가입/카드 등록 필요 없음)
WEATHER_CITY_NAME=서울
WEATHER_LAT=37.5665
WEATHER_LON=126.9780
# 30분마다 자동으로 새 날씨를 가져와요 (초 단위: 1800 = 30분)
WEATHER_FETCH_INTERVAL_SECONDS=1800

# 게시글을 PostgreSQL에서 MongoDB로 자동 백업하는 주기 (초 단위: 3600 = 1시간)
BACKUP_SYNC_INTERVAL_SECONDS=3600
